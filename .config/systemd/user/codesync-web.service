[Unit]
Description=CodeSync local frontend (Cloudflare backend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Desktop/Tech Stack
Environment=NODE_ENV=development
Environment=NEXT_PUBLIC_API_URL=https://codesync-api.sallydon164.workers.dev
Environment=NEXT_PUBLIC_WS_URL=wss://codesync-api.sallydon164.workers.dev/ws
Environment=CODE_SYNC_API_ORIGIN=https://codesync-api.sallydon164.workers.dev
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=PATH=%h/.nvm/versions/node/v26.13.0/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.nvm/versions/node/v26.13.0/bin/npm run dev:web
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15

[Install]
WantedBy=default.target
