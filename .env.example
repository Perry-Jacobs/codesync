# ─── Cloudflare frontend build variables ───────────────────────────
# Browser-facing frontend URL (replace with your deployed Worker URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional direct API Worker origin. Leave empty to use the frontend proxy.
NEXT_PUBLIC_API_URL=
# Browser-facing WebSocket Worker URL. Do not point this at the frontend.
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws

# ─── Cloudflare frontend Worker variable ──────────────────────────
# Server-side origin used by the Next.js proxy routes.
CODE_SYNC_API_ORIGIN=http://localhost:8787

# ─── Cloudflare API Worker variables ───────────────────────────────
# Comma-separated frontend origins allowed to call the API/WebSocket.
ALLOWED_ORIGINS=http://localhost:3000
# Public frontend URL used when generating join links.
PUBLIC_APP_URL=http://localhost:3000
MAX_PARTICIPANTS=8
ROOM_CREATE_LIMIT=12
ROOM_CREATE_WINDOW_SECONDS=600

# ─── WebRTC / TURN ────────────────────────────────────────────────
# STUN is free but does not guarantee connectivity.
STUN_SERVERS=stun:stun.l.google.com:19302
# A separately hosted TURN service is recommended for reliable calls.
TURN_SERVER=
# When present, the API Worker generates short-lived HMAC credentials.
TURN_SECRET=

# ─── Legacy Node/Redis backend (optional, not used by Cloudflare) ──
PORT=3000
WS_PORT=3000
REDIS_URL=redis://localhost:6379
SESSION_TTL_HOURS=1
RATE_LIMIT_MSGS_PER_SEC=60
JWT_SECRET=dev-only-change-me-dev-only-change-me
TRUST_PROXY_HEADERS=false
