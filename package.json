{
  "name": "codesync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "predev": "node scripts/copy-monaco.mjs",
    "dev": "tsx watch server/index.ts",
    "predev:web": "node scripts/copy-monaco.mjs",
    "dev:web": "cross-env NEXT_PUBLIC_API_URL=https://codesync-api.sallydon164.workers.dev NEXT_PUBLIC_WS_URL=wss://codesync-api.sallydon164.workers.dev/ws CODE_SYNC_API_ORIGIN=https://codesync-api.sallydon164.workers.dev next dev -p 3000",
    "dev:web:local": "cross-env NEXT_PUBLIC_API_URL=http://localhost:8787 NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws CODE_SYNC_API_ORIGIN=http://localhost:8787 next dev -p 3000",
    "prebuild": "node scripts/copy-monaco.mjs",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:backend:check": "npm --prefix workers/codesync run check",
    "cf:backend:deploy": "npm --prefix workers/codesync run deploy",
    "cf:backend:dev": "npm --prefix workers/codesync run dev",
    "cf:runtime:smoke": "tsx scripts/cf-runtime-smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ws:smoke": "tsx scripts/ws-smoke.ts",
    "ws:fs-multi-smoke": "tsx scripts/fs-multi-gateway-smoke.ts",
    "ws:session-smoke": "tsx scripts/session-smoke.ts",
    "ui:audit": "node scripts/ui-audit.mjs",
    "join:audit": "node scripts/join-toast-audit.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^11.15.0",
    "idb-keyval": "^6.2.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.0.9",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "ws": "^8.18.0",
    "yjs": "^13.6.20",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.29",
    "postcss": "8.5.32",
    "prettier": "^3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
